# Postgres (Supabase: use the connection string from Project Settings > Database)
DATABASE_URL="postgresql://user:password@host:5432/adlibrary"

# NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_URL="https://your-deployment-url"
# Google SSO (Workspace OAuth client) — required unless AUTH_DEV_BYPASS=true
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
ALLOWED_EMAIL_DOMAIN="alan.eu"
# Dev only: skip Google SSO entirely
AUTH_DEV_BYPASS="false"

# Storage: "local" (dev) or "supabase"
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="ad-assets"

# Figma REST API — personal access token of a team account with file read access
FIGMA_TOKEN=""

# Optional: enables AI auto-naming proposals for statics
ANTHROPIC_API_KEY=""

# Optional: enables distribution auto-detect from Meta (Marketing API).
# Token needs ads_read on the ad account; account id with or without "act_".
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""
